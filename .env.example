# Database Configuration
DATABASE_URL=sqlite:///./otbr_manager.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# OpenThread Configuration
OT_RCP_DEVICE=/dev/ttyACM0
OT_BACKBONE_INTERFACE=eth0

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Firmware Update Configuration
FIRMWARE_STORAGE_PATH=./firmware
MAX_FIRMWARE_SIZE_MB=50

# Attenuator Configuration
ATTENUATOR_ENABLED=true
ATTENUATOR_DEVICE=/dev/ttyUSB0
ATTENUATOR_RANGE_DB=0-90

# Monitoring Configuration
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Security
API_KEY=your-secret-api-key-change-this
JWT_SECRET=your-jwt-secret-change-this
